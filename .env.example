ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_STOCK_DATA_FEED=iex
# Stock snapshots, 60-second screens, and the 50-name market map use this feed.
ALPACA_OPTION_DATA_FEED=indicative

# Separate Alpaca Broker API correspondent integration for future customer accounts.
# Defaults to sandbox and is not connected to public routes yet.
ALPACA_BROKER_ENV=sandbox
ALPACA_BROKER_CLIENT_ID=
ALPACA_BROKER_CLIENT_SECRET=
STONK_BROKER_PARTNER_APPROVED=false
STONK_PUBLIC_BROKER_LIVE=

# Stonk is live-only. There is no paper-trading mode or paper endpoint fallback.
STONK_ALLOW_LIVE_TRADING=
# Hosted deployments require this additional explicit single-owner acknowledgement.
# Never set it for a public customer trading service.
STONK_SINGLE_OWNER_ACCOUNT=
STONK_TRADING_SECRET=

STONK_AUTOTRADE_ENABLED=false
STONK_AUTOTRADE_EXECUTE=false
STONK_AUTOTRADE_UNIVERSE=SPY,QQQ,IWM,AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA
STONK_AUTOTRADE_MAX_SYMBOLS=6
STONK_AUTOTRADE_MIN_SCORE=72
STONK_AUTOTRADE_ALLOWED_STRATEGIES=bull_call_debit_spread,bear_put_debit_spread
STONK_MAX_RISK_PER_TRADE_USD=250
STONK_MAX_DAILY_LOSS_USD=500

CRON_SECRET=
SEC_USER_AGENT=Stonk research terminal admin@example.com
FRED_API_KEY=

